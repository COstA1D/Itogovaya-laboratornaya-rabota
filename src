using json = nlohmann::json;

// ---------- чтение JSON-файла ----------
bool readJsonFile(const string& filename, json& data) {
    ifstream file(filename);
    if (!file.is_open()) {
        cout << "Не удалось открыть файл " << filename << endl;
        return false;
    }

    // проверка на пустой файл
    file.seekg(0, ios::end);
    if (file.tellg() == 0) {
        cout << "Файл " << filename << " пустой, пропускаю" << endl;
        return false;
    }

    // *** КРИТИЧНО: сбрасываем флаги ошибки ***
    file.seekg(0, ios::beg);
    file.clear();  // ← ЭТО ОТСУТСТВОВАЛО!

    try {
        file >> data;
    }
    catch (const json::parse_error& e) {
        cout << "Ошибка парсинга JSON в файле " << filename
            << ": " << e.what() << endl;
        return false;
    }
    return true;
}

// ---------- валидация структуры JSON ----------
bool validateTextJson(const json& data) {
    if (!data.is_object()) {
        cout << "Ошибка: корень JSON должен быть объектом { ... }" << endl;
        return false;
    }

    if (!data.contains("text")) {
        cout << "Ошибка: нет поля \"text\"" << endl;
        return false;
    }
    if (!data["text"].is_string()) {
        cout << "Ошибка: поле \"text\" должно быть строкой" << endl;
        return false;
    }

    if (data.contains("stopwords") && !data["stopwords"].is_array()) {
        cout << "Ошибка: поле \"stopwords\" должно быть массивом строк" << endl;
        return false;
    }

    if (data.contains("stopwords")) {
        for (const auto& v : data["stopwords"]) {
            if (!v.is_string()) {
                cout << "Ошибка: все элементы в \"stopwords\" должны быть строками" << endl;
                return false;
            }
        }
    }

    return true;
}

// ---------- генерация тестовых файлов ----------
void generateJsonFiles(int fileCount) {
    vector<string> samples = {
        "В начале было Слово и Слово было у Бога.",
        "Текст для частотного анализа текста.",
        "Ещё один пример текста для частотного анализа."
    };

    mt19937 gen(static_cast<unsigned int>(time(nullptr)));
    uniform_int_distribution<> textId(0, static_cast<int>(samples.size()) - 1);

    for (int i = 0; i < fileCount; ++i) {
        json obj;
        obj["text"] = samples[textId(gen)];
        obj["stopwords"] = json::array({ "и", "в", "у" });

        string filename = "text_" + to_string(i) + ".json";
        ofstream out(filename);

        if (!out.is_open()) {
            cout << "Не удалось создать файл " << filename << endl;
            continue;
        }

        // *** КЛЮЧЕВОЕ: используем error_handler_t::replace ***
        string json_str = obj.dump(2, ' ', true, json::error_handler_t::replace);
        out << json_str;
        out.close();

        cout << "Создан " << filename << endl;
    }
    cout << fileCount << " JSON-файлов сгенерировано" << endl;
}

// ---------- разбиение текста на слова ----------
void splitWords(const string& text,
    const vector<string>& stopwords,
    vector<string>& words_out) {
    if (text.empty()) return;

    set<string> stop(stopwords.begin(), stopwords.end());
    words_out.clear();
    words_out.reserve(256);

    string cur;

    auto flush = [&]() {
        if (cur.empty()) return;
        for (char& c : cur)
            c = static_cast<char>(tolower(static_cast<unsigned char>(c)));
        if (!stop.count(cur))
            words_out.push_back(cur);
        cur.clear();
        };

    for (char c : text) {
        if (isalnum(static_cast<unsigned char>(c))) {
            cur.push_back(c);
        }
        else {
            flush();
        }
    }
    flush();
}

// ---------- анализ текста ----------
void analyzeText(const json& data,
    bool timecheck,
    vector<string>& words_buffer,
    map<string, int>& freq_buffer) {
    if (!validateTextJson(data))
        return;

    string text = data["text"].get<string>();

    vector<string> stopwords;
    if (data.contains("stopwords")) {
        const auto& arr = data["stopwords"];
        stopwords.reserve(arr.size());
        for (const auto& v : arr)
            stopwords.push_back(v.get<string>());
    }

    auto start = chrono::high_resolution_clock::now();

    splitWords(text, stopwords, words_buffer);

    freq_buffer.clear();
    for (const auto& w : words_buffer)
        ++freq_buffer[w];

    vector<pair<string, int>> top;
    top.reserve(freq_buffer.size());
    for (const auto& kv : freq_buffer)
        top.push_back(kv);

    sort(top.begin(), top.end(), [](const auto& a, const auto& b) {
        if (a.second != b.second) return a.second > b.second;
        return a.first < b.first;
        });

    auto end = chrono::high_resolution_clock::now();
    auto dur = chrono::duration_cast<chrono::microseconds>(end - start).count();

    if (!timecheck) {
        cout << "Всего слов: " << words_buffer.size() << endl;
        cout << "Уникальных: " << freq_buffer.size() << endl;
        cout << "Top слова:" << endl;
        int limit = min<int>(top.size(), 20);
        for (int i = 0; i < limit; ++i)
            cout << top[i].first << " : " << top[i].second << endl;
    }
    else {
        cout << "Время анализа текста: " << dur << " мкс" << endl;
    }
}

// ---------- main ----------

int main() {
#ifdef _WIN32
    SetConsoleCP(65001);
    SetConsoleOutputCP(65001);
#endif
    cout << "================ ЧАСТОТНЫЙ АНАЛИЗ ТЕКСТА ================" << endl;

    vector<string> words_buffer;
    map<string, int> freq_buffer;

    while (true) {
        cout << "\nВыберите действие:" << endl
            << "1) Проверка валидности и анализ файлов" << endl
            << "2) Режим отладки (генерация и бенчмарк)" << endl
            << "3) Выход" << endl;

        string choose;
        cin >> choose;

        if (choose == "1") {
            int amount;
            cout << "Введите количество файлов: ";
            cin >> amount;

            for (int i = 0; i < amount; ++i) {
                string filename = "text_" + to_string(i) + ".json";
                json data;
                if (!readJsonFile(filename, data)) {
                    cout << "Пропуск файла " << filename << endl;
                    continue;
                }

                cout << "\nПроверка " << filename << endl;
                if (!validateTextJson(data)) {
                    cout << "Файл пропущен из-за ошибок" << endl;
                    continue;
                }

                cout << "Анализ " << filename << endl;
                analyzeText(data, false, words_buffer, freq_buffer);
                cout << "-----------------------" << endl;
            }
        }
        else if (choose == "2") {
            cout << "1) Сгенерировать JSON-файлы" << endl
                << "2) Замер времени анализа" << endl;
            cin >> choose;

            if (choose == "1") {
                int amount;
                cout << "Количество файлов: ";
                cin >> amount;
                generateJsonFiles(amount);
            }
            else if (choose == "2") {
                int amount;
                cout << "Количество файлов: ";
                cin >> amount;

                auto totalStart = chrono::high_resolution_clock::now();

                for (int i = 0; i < amount; ++i) {
                    string filename = "text_" + to_string(i) + ".json";
                    json data;
                    if (!readJsonFile(filename, data))
                        continue;
                    analyzeText(data, true, words_buffer, freq_buffer);
                }

                auto totalEnd = chrono::high_resolution_clock::now();
                auto totalDur =
                    chrono::duration_cast<chrono::milliseconds>(totalEnd - totalStart).count();

                cout << "\n===== ЗАМЕР ВРЕМЕНИ =====" << endl;
                cout << "Файлов проверено: " << amount << endl;
                cout << "Общее время: " << totalDur << " мс" << endl;
            }
            else {
                cout << "Неверный выбор" << endl;
            }
        }
        else if (choose == "3") {
            break;
        }
        else {
            cout << "Некорректный выбор (1-3!)" << endl;
        }
    }

    return 0;
}
